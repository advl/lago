{
  "name": "@aztlan/lago-core",
  "description": "What a terminal screen shows, and its golden, for any renderer Lago checks",
  "version": "0.1.0-rc.1",
  "type": "module",
  "module": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "author": {
    "email": "47156835+advl@users.noreply.github.com",
    "name": "advl"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/advl/lago.git",
    "directory": "packages/lago-core"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/advl/lago/issues"
  },
  "homepage": "https://github.com/advl/lago/tree/main/packages/lago-core#readme",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "bun run check:biome && bun run check:ts && bun run check:webarchitect",
    "check:fix": "bun run check:biome:fix && bun run check:ts",
    "check:biome": "biome check",
    "check:biome:fix": "biome check --write",
    "check:ts": "tsc --noEmit",
    "test": "bunx --bun vitest run",
    "test:coverage": "bunx --bun vitest run --coverage",
    "check:webarchitect": "webarchitect library --license MIT --prefix '@aztlan/'"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@canonical/biome-config": "0.44.0",
    "@canonical/typescript-config": "0.44.0",
    "@canonical/webarchitect": "0.44.0",
    "@vitest/coverage-v8": "5.1.0",
    "bun-types": "1.4.4",
    "fast-check": "4.10.2",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "engines": {
    "bun": ">=1.4.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "nx": {
    "targets": {
      "ci": {
        "executor": "nx:noop",
        "dependsOn": [
          "build",
          "check",
          "test:coverage"
        ]
      }
    }
  }
}
