{
  "name": "@aztlan/lago",
  "description": "A gallery of a project's stories, in a terminal",
  "version": "0.0.0",
  "type": "module",
  "module": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "author": {
    "email": "47156835+advl@users.noreply.github.com",
    "name": "advl"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/advl/lago",
    "directory": "packages/lago"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/advl/lago/issues"
  },
  "homepage": "https://github.com/advl/lago/tree/main/packages/lago#readme",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "bun run check:biome && bun run check:ts && bun run check:webarchitect",
    "check:fix": "bun run check:biome:fix && bun run check:ts",
    "check:biome": "biome check",
    "check:biome:fix": "biome check --write",
    "check:ts": "tsc --noEmit",
    "test": "bunx --bun vitest run",
    "test:coverage": "bunx --bun vitest run --coverage --project unit && bunx --bun vitest run --project stories --passWithNoTests",
    "check:webarchitect": "webarchitect library --license MIT --prefix '@aztlan/'"
  },
  "dependencies": {
    "@aztlan/lago-react": "0.0.0",
    "@aztlan/tui": "0.0.0"
  },
  "devDependencies": {
    "@aztlan/lago-config": "0.0.0",
    "@biomejs/biome": "2.5.15",
    "@canonical/biome-config": "0.44.0",
    "@canonical/typescript-config": "0.44.0",
    "@canonical/webarchitect": "0.44.0",
    "@opentui/core": "0.8.4",
    "@opentui/keymap": "0.8.4",
    "@opentui/react": "0.8.4",
    "@types/react": "19.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "bun-types": "1.4.4",
    "react": "19.3.1",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.8.0 <0.9.0",
    "@opentui/keymap": ">=0.8.0 <0.9.0",
    "@opentui/react": ">=0.8.0 <0.9.0",
    "react": ">=19.2.0",
    "vitest": ">=5.0.0 <6.0.0"
  },
  "engines": {
    "bun": ">=1.4.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "nx": {
    "targets": {
      "ci": {
        "executor": "nx:noop",
        "dependsOn": [
          "build",
          "check",
          "test:coverage"
        ]
      }
    }
  }
}
