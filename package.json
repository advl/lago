{
  "name": "lago",
  "private": true,
  "version": "0.0.0",
  "description": "Stories for terminal interfaces drawn by OpenTUI: tested on every run, browsed in a terminal",
  "type": "module",
  "author": {
    "email": "47156835+advl@users.noreply.github.com",
